CAM_07_URL=rtsp://user:password@192.168.1.107:554/Streaming/Channels/101
CAM_08_URL=rtsp://user:password@192.168.1.108:554/Streaming/Channels/101
CAM_09_URL=rtsp://user:password@192.168.1.109:554/Streaming/Channels/101
CAM_10_URL=rtsp://user:password@192.168.1.110:554/Streaming/Channels/101
CAM_11_URL=rtsp://user:password@192.168.1.111:554/Streaming/Channels/101
CAM_12_URL=rtsp://user:password@192.168.1.112:554/Streaming/Channels/101
CAM_13_URL=rtsp://user:password@192.168.1.113:554/Streaming/Channels/101
CAM_14_URL=rtsp://user:password@192.168.1.114:554/Streaming/Channels/101
CAM_15_URL=rtsp://user:password@192.168.1.115:554/Streaming/Channels/101
CAM_16_URL=rtsp://user:password@192.168.1.116:554/Streaming/Channels/101
CAM_17_URL=rtsp://user:password@192.168.1.117:554/Streaming/Channels/101
CAM_18_URL=rtsp://user:password@192.168.1.118:554/Streaming/Channels/101
CAM_19_URL=rtsp://user:password@192.168.1.119:554/Streaming/Channels/101
CAM_20_URL=rtsp://user:password@192.168.1.120:554/Streaming/Channels/101
CAM_21_URL=rtsp://user:password@192.168.1.121:554/Streaming/Channels/101
CAM_22_URL=rtsp://user:password@192.168.1.122:554/Streaming/Channels/101
CAM_23_URL=rtsp://user:password@192.168.1.123:8554/profile0
CAM_24_URL=rtsp://user:password@192.168.1.124:8554/profile0
CAM_25_URL=rtsp://user:password@192.168.1.125:8554/profile0

# --- Dizin Yolları ---
DATABASE_PATH=database
KNOWN_PATH=snapshots/known
UNKNOWN_PATH=snapshots/unknown
LOG_DIR=logs

# --- Tespit Parametreleri ---
THRESHOLD=0.45
INFERENCE_FPS=4
SNAPSHOT_COOLDOWN=20
PATROL_SCAN_SECONDS=10
PATROL_HOLD_SECONDS=20
LOG_THROTTLE_SECONDS=30

# --- Plaka Tanıma ---
# PLATE_DETECTOR_CONF: license plate detector (YOLO) confidence threshold.
# 0.25 too permissive (yields fragmented bbox), 0.40 cleaner input to OCR.
PLATE_DETECTOR_CONF=0.40

# --- Plaka Whitelist (PLAKA-2.H) ---
# Whitelist file lists known plates (family/acquaintances). System matches
# OCR output to whitelist via fuzzy match (Levenshtein distance ≤ 2 + same
# city code). Unknown plates are saved to PLATE_UNKNOWN_SAVE_DIR but do not
# trigger Telegram alerts. If whitelist file is missing/empty, all plates
# proceed to vote/notification (legacy behavior, opt-in mode).
PLATE_WHITELIST_PATH=config/plate_whitelist.txt
PLATE_UNKNOWN_SAVE_DIR=unknown_plates
PLATE_UNKNOWN_THROTTLE_SECONDS=30

# --- Temizlik ---
SNAPSHOT_MAX_AGE_DAYS=7
SNAPSHOT_MAX_FILES=500

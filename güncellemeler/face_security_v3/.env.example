# =============================================================
# Face Security v3 — Ortam Değişkenleri Şablonu
# Bu dosyayı .env olarak kopyalayın ve gerçek değerleri girin.
# .env dosyasını ASLA Git'e eklemeyin!
# =============================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Kamera URL'leri (RTSP) ---
CAM_01_URL=rtsp://user:password@192.168.1.101:554/Streaming/Channels/101
